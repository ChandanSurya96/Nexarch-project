# backend
DATABASE_URL=postgresql://nexarch:nexarch@localhost:5432/nexarch
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
ENCRYPTION_KMS_KEY_ID=
# Key rotation (ADR-044). Leave both blank normally — ENCRYPTION_KMS_KEY_ID
# alone is key version 1 and is active, which is all a single-key setup needs.
# During a rotation, list every key that must stay readable and name the one
# new writes should use, then run scripts/rewrap_encryption_keys.py:
#   ENCRYPTION_KEYS=1:<old secret>,2:<new secret>
#   ENCRYPTION_ACTIVE_KEY_VERSION=2
# Do NOT drop a key until `--status` reports zero tokens left on it.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_VERSION=

# broker integrations (see docs/broker-integrations.md)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
DHAN_API_KEY=
ANGELONE_API_KEY=
FYERS_API_KEY=
GROWW_API_KEY=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# account aggregator (see docs/broker-integrations.md)
AA_CLIENT_ID=
AA_PROVIDER_BASE_URL=

# flask
FLASK_ENV=development
FLASK_APP=wsgi.py

# error tracking (ADR-041) — optional everywhere.
# Leave EMPTY and Sentry is completely inert: no client, no network calls,
# nothing sent. Set it only in deployed environments.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Set automatically by the deploy workflow (git SHA); leave empty locally.
APP_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION NOTE (ADR-039)
#
# In production the app REFUSES TO START unless JWT_SECRET,
# ENCRYPTION_KMS_KEY_ID, DATABASE_URL and REDIS_URL are all set to real
# values — non-empty, not placeholders, secrets at least 32 characters, and
# REDIS_URL not pointing at localhost.
#
# This is deliberate: before that validation existed, a production deploy
# with JWT_SECRET unset started cleanly and signed JWTs with the empty
# string, which anyone could forge for any user id.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# See docs/operations.md for the full environment-variable table.
# ─────────────────────────────────────────────────────────────────────────────

# ── Scheduled sync fan-out (ADR-046) ──────────────────────────────────────
# The daily sync is spread over this window in batches instead of firing
# every connection at 02:00:00. Widen the window or shrink the batch if a
# broker starts rate-limiting during the run.
SYNC_WINDOW_MINUTES=120
SYNC_BATCH_SIZE=20

# ── Sync monitoring thresholds (ADR-047) ──────────────────────────────────
# Read by GET /health/sync. Defaults assume the daily 02:00 schedule.
SYNC_SCHEDULER_MAX_AGE_HOURS=26
SYNC_WORKER_MAX_AGE_HOURS=26
SYNC_SUCCESS_MAX_AGE_HOURS=50
SYNC_MAX_ERROR_RATIO=0.5
